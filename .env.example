# =============================================================================
# File MẪU cấu hình server Cờ Tướng.
#
# Copy file này thành `.env` rồi điền giá trị thật:
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (PowerShell)
#
# `.env` nằm trong .gitignore — CHỨA BÍ MẬT THẬT, KHÔNG commit, không chia sẻ.
# Nạp bằng cờ sẵn có của Node: `node --env-file=.env` (xem scripts trong package.json).
# Bỏ trống một biến thì server dùng mặc định ghi trong chú thích.
# =============================================================================

APP_NAME=Cờ tướng online
# ---------------- Máy chủ ----------------
PORT=3000
# Cổng HTTPS (chỉ dùng khi có đủ chứng chỉ TLS ở mục HTTPS/TLS bên dưới)
HTTPS_PORT=3443
# Nguồn được phép kết nối (web). Production nên đặt domain cụ thể
CORS_ORIGIN=*
# Thời gian chờ người chơi nối lại trước khi xử thua (ms)
RECONNECT_GRACE_MS=60000
# Đặt 1 chỉ khi server nằm sau reverse proxy đáng tin (để lấy IP thật từ X-Forwarded-For)
TRUST_PROXY=0
# Trang tài liệu API (Swagger UI) tại /docs. Mặc định BẬT; đặt 0 để TẮT (vd. ở production).
DOCS_ENABLED=1

# ---------------- Ghi log (Pino) ----------------
# Log ra JSON một dòng (NDJSON) theo chuẩn Elastic Common Schema: nuốt được ngay bởi
# ELK, Grafana Loki, Datadog, AWS CloudWatch Logs mà không cần parser riêng.
# Mức log: fatal | error | warn | info | debug | trace. Mặc định info (production), debug (dev).
LOG_LEVEL=info
# Chỉ DEV: đặt 1 để in log màu, dễ đọc bằng pino-pretty (production luôn in JSON thuần).
LOG_PRETTY=0
# Tên + phiên bản dịch vụ gắn vào mọi dòng log (để lọc theo service trên dashboard).
# Để trống: mặc định "xiangqi-server"; phiên bản lấy từ package.json.
SERVICE_NAME=xiangqi-server
SERVICE_VERSION=
# NODE_ENV=production bật chế độ log cho môi trường thật (JSON, không in đẹp).
# NODE_ENV=production

# ---------------- HTTPS / TLS ----------------
# HTTPS là TUỲ CHỌN. Bỏ trống -> chỉ chạy HTTP (đúng cho Railway/Render/Fly: nền tảng tự lo TLS).
# Có đủ 2 file -> server chạy ĐỒNG THỜI HTTP (PORT) và HTTPS (HTTPS_PORT).
# Đường dẫn tương đối tính từ thư mục gốc project. Thư mục .ssl/ nằm trong .gitignore.
#   choco install mkcert ; mkcert -install
#   mkdir .ssl ; mkcert -key-file .ssl/localhost-key.pem -cert-file .ssl/localhost.pem localhost 127.0.0.1 10.0.2.2
TLS_KEY_FILE=
TLS_CERT_FILE=
# Chuỗi chứng chỉ trung gian (nếu nhà cung cấp yêu cầu) và mật khẩu của khoá riêng
TLS_CA_FILE=
TLS_PASSPHRASE=

# ---------------- JWT (đăng nhập) ----------------
# Khoá bí mật để ký access/refresh token (HS256). BẮT BUỘC đặt khi chạy thật.
# Bỏ trống -> server tự sinh khoá ngẫu nhiên mỗi lần khởi động (có cảnh báo).
# Sinh khoá mới: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Tuổi của access token (ms). Mặc định 1 giờ.
JWT_ACCESS_TTL_MS=3600000
# Tuổi của phiên = tuổi của refresh token (ms). Mặc định 30 ngày.
SESSION_TTL_MS=2592000000

# ---------------- PostgreSQL ----------------
# Bỏ trống = lưu tạm trong bộ nhớ (MẤT hết khi tắt server). Khuyến nghị luôn đặt khi chạy thật.
# Mẫu: postgres://USER:PASSWORD@localhost:5432/DBNAME
# Mật khẩu có ký tự đặc biệt (@, #, /, ...) phải URL-encode (vd. @ -> %40)
DATABASE_URL=
# Tự tạo/nâng cấp bảng khi khởi động (đặt 0 để tự chạy `npm run migrate`)
AUTO_MIGRATE=1
# Số ngày giữ lịch sử đăng nhập (có chứa địa chỉ IP nên không nên giữ vô hạn)
AUTH_EVENT_RETENTION_DAYS=180

# ---------------- Tính điểm Elo ----------------
# Cho phép ván TÀI KHOẢN đấu KHÁCH được tính điểm. Mặc định 0 (TẮT): chỉ ván giữa hai tài khoản mới
# tính điểm, an toàn cho bảng xếp hạng. Đặt 1 để BẬT: tài khoản được cộng/trừ điểm (lưu server, lên
# bảng xếp hạng) dựa trên điểm khách do client gửi; khách tự lưu điểm tại máy.
# ⚠ Khi BẬT: điểm khách do client tự khai, nên đối thủ khách có thể bị lợi dụng để bơm/dìm điểm tài khoản.
RATE_VS_GUEST=0

# ---------------- Đăng nhập Google / Facebook / Zalo / Apple ----------------
# Địa chỉ công khai của server (HTTPS). Dùng để tạo redirect_uri:
#   <PUBLIC_URL>/auth/oauth/google/callback   (tương tự cho facebook, zalo, apple)
# Chạy máy cục bộ: PUBLIC_URL=https://localhost:3443
PUBLIC_URL=https://localhost:3443
# Địa chỉ trình duyệt được phép chuyển về app (phân tách bằng dấu phẩy, khớp CHÍNH XÁC)
OAUTH_APP_REDIRECTS=cotuong://auth,http://localhost:8080/auth.html
# Chỉ nhà cung cấp nào có đủ id + secret mới được bật.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Phiên bản Graph API: kiểm tra phiên bản còn hiệu lực
FACEBOOK_API_VERSION=v27.0
ZALO_APP_ID=
ZALO_APP_SECRET=
# Xác thực domain với Zalo (mục "Xác thực domain" trong Zalo Developer). Vì không sửa được DNS,
# server phục vụ trực tiếp file HTML mà Zalo yêu cầu, tại ĐÚNG đường dẫn Zalo chỉ định.
# ZALO_VERIFY_FILE : đường dẫn đầy đủ (gồm path), KHỚP TỪNG KÝ TỰ với URL Zalo đưa.
# ZALO_VERIFY_HTML : nội dung HTML y hệt file Zalo cấp (một dòng; viết xuống dòng bằng \n nếu cần).
# ZALO_VERIFY_CODE : chỉ dùng khi KHÔNG đặt ZALO_VERIFY_HTML (server tự dựng thẻ meta tối thiểu).
# Zalo cấp file mới chỉ cần đổi mấy biến này, không phải sửa code.
ZALO_VERIFY_FILE=
ZALO_VERIFY_HTML=
ZALO_VERIFY_CODE=
# Đăng nhập với Apple: cần đủ 4 biến mới bật.
#   APPLE_CLIENT_ID   : Services ID (vd com.example.cotuong.web)
#   APPLE_TEAM_ID     : Team ID (10 ký tự) ở Apple Developer
#   APPLE_KEY_ID      : Key ID của khoá "Sign in with Apple" (.p8)
#   APPLE_PRIVATE_KEY : nội dung khoá .p8 (PEM), một dòng, thay xuống dòng bằng \n
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---------------- Gửi email (quên mật khẩu, xác minh email) ----------------
# Không đặt SMTP_HOST: khi dev mã được IN RA CONSOLE; khi NODE_ENV=production email bị tắt.
# Gmail: SMTP_HOST=smtp.gmail.com, cổng 465 (SMTP_SECURE=1) hoặc 587.
# SMTP_PASS phải là "Mật khẩu ứng dụng" (App password), KHÔNG phải mật khẩu Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# Địa chỉ hiện ở ô "Từ" (để trống = dùng SMTP_USER). Gmail yêu cầu trùng SMTP_USER.
SMTP_FROM=
# Hộp thư nhận "Thư góp ý" (POST /feedback). Để trống = dùng SMTP_USER.
FEEDBACK_TO=
# Xác minh chuỗi chứng chỉ TLS của SMTP. Mặc định 1 (AN TOÀN, giữ ở production).
# Chỉ dev sau proxy/antivirus mới đặt 0 để bỏ xác minh (có cảnh báo khi khởi động).
SMTP_TLS_REJECT_UNAUTHORIZED=1
# SMTP_TLS_CA_FILE=D:/duong-dan/ca-proxy.pem
