{
  "name": "xiangqi-server",
  "version": "0.1.3",
  "description": "Server cờ tướng online (Node.js + Socket.IO). Server làm trọng tài: kiểm tra mọi nước đi bằng engine luật riêng.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "start:prod": "node src/index.js",
    "dev": "node --env-file=.env --watch src/index.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "test": "node --test",
    "demo": "node scripts/demo.js",
    "ratings:rebuild": "node --env-file=.env scripts/rebuild-ratings.js"
  },
  "license": "MIT",
  "dependencies": {
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "socket.io": "^4.8.4",
    "swagger-ui-dist": "^5.34.1"
  },
  "devDependencies": {
    "mailparser": "^3.10.0",
    "pino-pretty": "^13.0.0",
    "smtp-server": "^3.20.2",
    "socket.io-client": "^4.8.4"
  }
}
