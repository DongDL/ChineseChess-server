# ---------------- Máy chủ ----------------
PORT=3000
# Nguồn được phép kết nối (web). Production nên đặt domain cụ thể
CORS_ORIGIN=*
# Thời gian chờ người chơi nối lại trước khi xử thua (ms)
RECONNECT_GRACE_MS=60000
# Đặt 1 chỉ khi server nằm sau reverse proxy đáng tin (để lấy IP thật từ X-Forwarded-For)
TRUST_PROXY=0

# ---------------- PostgreSQL ----------------
# Bỏ trống = lưu tạm trong bộ nhớ (MẤT hết khi tắt server). Khuyến nghị luôn đặt khi chạy thật.
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgres://postgres:Admin!!668!@localhost:5432/ChessDb
# Tự tạo/nâng cấp bảng khi khởi động (đặt 0 để tự chạy `npm run migrate`)
AUTO_MIGRATE=1
# Số ngày giữ lịch sử đăng nhập (có chứa địa chỉ IP nên không nên giữ vô hạn)
AUTH_EVENT_RETENTION_DAYS=180

# ---------------- Đăng nhập Google / Facebook / Zalo ----------------
# Địa chỉ công khai của server (HTTPS). Dùng để tạo redirect_uri gửi cho nhà cung cấp:
#   <PUBLIC_URL>/auth/oauth/google/callback   (tương tự cho facebook, zalo)
PUBLIC_URL=https://cotuong.example.com
# Địa chỉ trình duyệt được phép chuyển về app (phân tách bằng dấu phẩy, khớp CHÍNH XÁC)
OAUTH_APP_REDIRECTS=cotuong://auth
# Chỉ nhà cung cấp nào có đủ id + secret mới được bật
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Phiên bản Graph API: Facebook ngừng các phiên bản cũ sau ~2 năm, hãy kiểm tra phiên bản còn hiệu lực
FACEBOOK_API_VERSION=v24.0
ZALO_APP_ID=
ZALO_APP_SECRET=

# ---------------- Gửi email (quên mật khẩu, xác minh email) ----------------
# Không đặt SMTP_HOST: khi phát triển mã được IN RA CONSOLE; khi NODE_ENV=production tính năng email bị tắt.
# Gmail: SMTP_HOST=smtp.gmail.com, cổng 465 (SMTP_SECURE=1) hoặc 587. SMTP_PASS phải là "Mật khẩu ứng dụng" (App password,
# tạo ở tài khoản Google sau khi bật xác minh 2 bước), KHÔNG phải mật khẩu đăng nhập Google. Không commit file .env.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
# Địa chỉ hiện ở ô "Từ" (để trống = dùng SMTP_USER)
SMTP_FROM=
APP_NAME=Cờ tướng online
