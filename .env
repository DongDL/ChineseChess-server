# =============================================================================
# Cấu hình server Cờ Tướng — file DUY NHẤT (không còn .env.example)
#
# File này CHỨA BÍ MẬT THẬT và đã nằm trong .gitignore — KHÔNG commit, không chia sẻ.
# Nạp bằng cờ sẵn có của Node: `node --env-file=.env` (xem scripts trong package.json),
# nên không cần thư viện dotenv.
#
# Khi dựng máy mới / deploy: copy file này rồi THAY mọi bí mật (JWT_SECRET, DATABASE_URL,
# SMTP_PASS, khoá OAuth). Bỏ trống một biến thì server dùng mặc định ghi trong chú thích.
# =============================================================================

# ---------------- Máy chủ ----------------
PORT=3000
# Cổng HTTPS (chỉ dùng khi có đủ chứng chỉ TLS ở mục HTTPS/TLS bên dưới)
HTTPS_PORT=3443
# Nguồn được phép kết nối (web). Production nên đặt domain cụ thể
CORS_ORIGIN=*
# Thời gian chờ người chơi nối lại trước khi xử thua (ms)
RECONNECT_GRACE_MS=60000
# Đặt 1 chỉ khi server nằm sau reverse proxy đáng tin (để lấy IP thật từ X-Forwarded-For)
TRUST_PROXY=0
